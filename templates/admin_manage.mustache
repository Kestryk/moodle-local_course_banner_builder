{{!
    This file is part of Moodle - http://moodle.org/

    @template local_course_banner_builder/admin_manage

    Configured banner list.

    Example context (json):
    {
        "hasitems": true,
        "haschains": false,
        "items": [
            {
                "rowclass": "local-course-banner-builder-source-row",
                "sourcekeyhash": "source-1",
                "parentkeyhash": "",
                "hierarchylevel": 0,
                "hierarchylevelmarkers": [],
                "haschildren": false,
                "isselectedsource": true,
                "rowstyle": "",
                "sourcename": "Category source",
                "sourcetype": "Category",
                "layercount": "2",
                "compositionmode": "Cumulative",
                "sourcesettingsurl": "https://example.test/local/course_banner_builder/admin_manage.php?categoryid=1&opensourcesettings=1",
                "fitmode": "Keep proportions",
                "previewhtml": "",
                "actions": []
            }
        ]
    }
}}
<div data-region="local-course-banner-builder-configured-sources">
{{#hasitems}}
    {{#haschains}}
        <div class="local-course-banner-builder-configured-source-tools">
            <button type="button"
                class="btn btn-outline-secondary btn-sm local-course-banner-builder-chain-collapse-toggle"
                data-action="local-course-banner-builder-toggle-all-source-chains"
                data-collapse-label="{{#str}}collapseallsourcechains, local_course_banner_builder{{/str}}"
                data-expand-label="{{#str}}expandallsourcechains, local_course_banner_builder{{/str}}">
                <i class="icon fa fa-compress fa-fw" aria-hidden="true"></i>
                <span>{{#str}}collapseallsourcechains, local_course_banner_builder{{/str}}</span>
            </button>
        </div>
    {{/haschains}}
    <div class="table-responsive local-course-banner-builder-table-shell local-course-banner-builder-table-shell--sources">
        <table class="generaltable local-course-banner-builder-configured-sources-table">
            <colgroup>
                <col class="local-course-banner-builder-configured-col-hierarchy">
                <col class="local-course-banner-builder-configured-col-parent">
                <col class="local-course-banner-builder-configured-col-name">
                <col class="local-course-banner-builder-configured-col-type">
                <col class="local-course-banner-builder-configured-col-layers">
                <col class="local-course-banner-builder-configured-col-mode">
                <col class="local-course-banner-builder-configured-col-preview">
                <col class="local-course-banner-builder-configured-col-actions">
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">{{#str}}hierarchy, local_course_banner_builder{{/str}}</th>
                    <th scope="col">{{#str}}sourceparentkey, local_course_banner_builder{{/str}}</th>
                    <th scope="col">{{#str}}sourcename, local_course_banner_builder{{/str}}</th>
                    <th scope="col">{{#str}}sourcetype, local_course_banner_builder{{/str}}</th>
                    <th scope="col">{{#str}}layers, local_course_banner_builder{{/str}}</th>
                    <th scope="col">{{#str}}compositionmode, local_course_banner_builder{{/str}}</th>
                    <th scope="col">{{#str}}bannerimage, local_course_banner_builder{{/str}}</th>
                    <th scope="col">{{#str}}actions, local_course_banner_builder{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#items}}
                    <tr class="{{rowclass}}"
                        id="local-course-banner-builder-source-chain-row-{{sourcekeyhash}}"
                        data-source-chain-row="1"
                        data-source-chain-key="{{sourcekeyhash}}"
                        data-source-chain-parent="{{parentkeyhash}}"
                        data-source-chain-level="{{hierarchylevel}}"
                        {{#isselectedsource}} aria-current="true"{{/isselectedsource}}
                        {{#rowstyle}} style="{{rowstyle}}"{{/rowstyle}}>
                        <td class="local-course-banner-builder-hierarchy-cell">
                            {{#hierarchylevelmarkers}}
                                <span class="local-course-banner-builder-hierarchy-level-line{{markerclass}}" style="{{style}}" aria-hidden="true"></span>
                            {{/hierarchylevelmarkers}}
                            {{#haschildren}}
                                <button type="button"
                                    class="btn btn-link local-course-banner-builder-chain-row-toggle"
                                    data-action="local-course-banner-builder-toggle-source-chain"
                                    data-source-chain-toggle="{{sourcekeyhash}}"
                                    aria-expanded="true">
                                    <i class="icon fa fa-chevron-down fa-fw" aria-hidden="true"></i>
                                    <span class="sr-only">{{#str}}toggle{{/str}}</span>
                                </button>
                            {{/haschildren}}
                            {{#hasbranchlabel}}
                                <div class="local-course-banner-builder-hierarchy-topline">
                                    <div class="local-course-banner-builder-branch-label">{{branchlabel}}</div>
                                </div>
                            {{/hasbranchlabel}}
                            <span class="local-course-banner-builder-hierarchy{{#islevelrow}} local-course-banner-builder-hierarchy--level{{/islevelrow}}{{#isrootrow}} local-course-banner-builder-hierarchy--root{{/isrootrow}}">
                                {{hierarchyarrows}}{{#isrootrow}}<strong>{{hierarchylabel}}</strong>{{/isrootrow}}{{^isrootrow}}{{hierarchylabel}}{{/isrootrow}}
                            </span>
                            {{#isisolated}}
                                <a class="btn btn-link p-0 ml-2 icon-no-margin local-course-banner-builder-shortcircuit-help"
                                   role="button"
                                   data-container="body"
                                   data-toggle="popover"
                                   data-placement="right"
                                   data-content="{{shortcircuitpopovercontent}}"
                                   data-html="true"
                                   data-trigger="hover"
                                   tabindex="0"
                                   aria-label="{{shortcircuithelp}}">
                                    <i class="icon fa fa-circle-question text-warning fa-fw" title="{{shortcircuithelp}}" role="img" aria-label="{{shortcircuithelp}}"></i>
                                </a>
                            {{/isisolated}}
                        </td>
                        <td class="local-course-banner-builder-source-parent-cell">
                            {{#hasbranchhead}}
                                <span class="local-course-banner-builder-parent-branch-connector"
                                    role="button"
                                    tabindex="0"
                                    data-container="body"
                                    data-toggle="popover"
                                    data-placement="top"
                                    data-content="{{branchsplitpopovercontent}}"
                                    data-html="true"
                                    data-trigger="hover"
                                    aria-label="{{branchsplithelp}}"
                                    title="{{branchsplithelp}}">
                                    <i class="icon fa fa-code-branch fa-fw" aria-hidden="true"></i>
                                </span>
                            {{/hasbranchhead}}
                            {{#hasparentconnector}}
                                <span class="local-course-banner-builder-parent-chain-connector" aria-hidden="true">
                                    <i class="icon fa fa-arrow-down fa-fw" aria-hidden="true"></i>
                                </span>
                            {{/hasparentconnector}}
                            <span class="local-course-banner-builder-summary-inline-view local-course-banner-builder-source-parent-view">
                                <span class="local-course-banner-builder-summary-inline-value">{{parentdisplayvalue}}</span>
                                <button type="button"
                                    class="btn btn-link p-0 icon-no-margin local-course-banner-builder-summary-inline-trigger local-course-banner-builder-source-parent-trigger"
                                    data-action="local-course-banner-builder-change-source-parent"
                                    data-source-key="{{sourcekey}}"
                                    data-source-key-hash="{{sourcekeyhash}}"
                                    data-source-label="{{categoryname}}"
                                    data-source-parent-label="{{parentdisplayvalue}}"
                                    data-source-parent-value="{{parentselectedvalue}}"
                                    data-source-sesskey="{{sesskey}}"
                                    data-source-options-template="local-course-banner-builder-parent-options-{{sourcekeyhash}}"
                                    aria-label="{{#str}}changesourceparent, local_course_banner_builder{{/str}}: {{categoryname}}">
                                    <i class="icon fa fa-pen fa-fw" aria-hidden="true"></i>
                                </button>
                            </span>
                        </td>
                        <td>
                            <a href="{{categoryadminurl}}">{{categoryname}}</a>
                            {{#isselectedsource}}
                                <span class="local-course-banner-builder-current-source-badge">
                                    <i class="fa fa-pen-to-square" aria-hidden="true"></i>
                                    <span>{{currentlyeditinglabel}}</span>
                                </span>
                            {{/isselectedsource}}
                        </td>
                        <td>{{sourcetypelabel}}</td>
                        <td>{{layercountdisplay}}</td>
                        <td>
                            <span class="local-course-banner-builder-summary-inline-view local-course-banner-builder-source-composition-view">
                                <span class="local-course-banner-builder-summary-inline-value">{{compositionmodelabel}}</span>
                                <a href="{{sourcesettingsurl}}"
                                    class="btn btn-link p-0 icon-no-margin local-course-banner-builder-summary-inline-trigger local-course-banner-builder-summary-edit-trigger local-course-banner-builder-source-settings-trigger"
                                    aria-label="{{#str}}edit{{/str}}: {{#str}}compositionmode, local_course_banner_builder{{/str}} — {{categoryname}}">
                                    <i class="icon fa fa-pen fa-fw" aria-hidden="true"></i>
                                </a>
                            </span>
                        </td>
                        <td>
                            <div class="local-course-banner-builder-thumb-list">
                                {{#thumbnails}}
                                    <div class="local-course-banner-builder-thumb-item" title="{{name}}">
                                        <img src="{{imageurl}}" alt="">
                                        <span class="local-course-banner-builder-thumb-badge-stack">
                                            {{#iscropped}}
                                                <span class="local-course-banner-builder-thumb-status-badge local-course-banner-builder-thumb-crop-badge"
                                                    role="button"
                                                    data-container="body"
                                                    data-toggle="popover"
                                                    data-placement="right"
                                                    data-content="{{croppedpopovercontent}}"
                                                    data-html="true"
                                                    data-trigger="hover"
                                                    tabindex="0"
                                                    aria-label="{{croppedlabel}}">
                                                    <i class="fa fa-crop" aria-hidden="true"></i>
                                                </span>
                                            {{/iscropped}}
                                            {{#isaboveborder}}
                                                <span class="local-course-banner-builder-thumb-status-badge local-course-banner-builder-thumb-above-border-badge"
                                                    role="button"
                                                    data-container="body"
                                                    data-toggle="popover"
                                                    data-placement="right"
                                                    data-content="{{aboveborderpopovercontent}}"
                                                    data-html="true"
                                                    data-trigger="hover"
                                                    tabindex="0"
                                                    aria-label="{{aboveborderlabel}}">
                                                    <i class="fa fa-level-up" aria-hidden="true"></i>
                                                </span>
                                            {{/isaboveborder}}
                                            {{#isaboveoverlay}}
                                                <span class="local-course-banner-builder-thumb-status-badge local-course-banner-builder-thumb-above-overlay-badge"
                                                    role="button"
                                                    data-container="body"
                                                    data-toggle="popover"
                                                    data-placement="right"
                                                    data-content="{{aboveoverlaypopovercontent}}"
                                                    data-html="true"
                                                    data-trigger="hover"
                                                    tabindex="0"
                                                    aria-label="{{aboveoverlaylabel}}">
                                                    <i class="fa fa-layer-group" aria-hidden="true"></i>
                                                </span>
                                            {{/isaboveoverlay}}
                                            {{#isaboveboth}}
                                                <span class="local-course-banner-builder-thumb-status-badge local-course-banner-builder-thumb-above-both-badge"
                                                    role="button"
                                                    data-container="body"
                                                    data-toggle="popover"
                                                    data-placement="right"
                                                    data-content="{{abovebothpopovercontent}}"
                                                    data-html="true"
                                                    data-trigger="hover"
                                                    tabindex="0"
                                                    aria-label="{{abovebothlabel}}">
                                                    <i class="fa fa-clone" aria-hidden="true"></i>
                                                </span>
                                            {{/isaboveboth}}
                                            {{#isbelowinherited}}
                                                <span class="local-course-banner-builder-thumb-status-badge local-course-banner-builder-thumb-below-inherited-badge"
                                                    role="button"
                                                    data-container="body"
                                                    data-toggle="popover"
                                                    data-placement="right"
                                                    data-content="{{belowinheritedpopovercontent}}"
                                                    data-html="true"
                                                    data-trigger="hover"
                                                    tabindex="0"
                                                    aria-label="{{belowinheritedlabel}}">
                                                    <i class="fa fa-level-down" aria-hidden="true"></i>
                                                </span>
                                            {{/isbelowinherited}}
                                            {{#isaboveinherited}}
                                                <span class="local-course-banner-builder-thumb-status-badge local-course-banner-builder-thumb-above-inherited-badge"
                                                    role="button"
                                                    data-container="body"
                                                    data-toggle="popover"
                                                    data-placement="right"
                                                    data-content="{{aboveinheritedpopovercontent}}"
                                                    data-html="true"
                                                    data-trigger="hover"
                                                    tabindex="0"
                                                    aria-label="{{aboveinheritedlabel}}">
                                                    <i class="fa fa-layer-group" aria-hidden="true"></i>
                                                </span>
                                            {{/isaboveinherited}}
                                            {{#iscenterfixed}}
                                                <span class="local-course-banner-builder-thumb-status-badge local-course-banner-builder-thumb-center-fixed-badge"
                                                    role="button"
                                                    data-container="body"
                                                    data-toggle="popover"
                                                    data-placement="right"
                                                    data-content="{{centerfixedpopovercontent}}"
                                                    data-html="true"
                                                    data-trigger="hover"
                                                    tabindex="0"
                                                    aria-label="{{centerfixedlabel}}">
                                                    <i class="fa fa-thumb-tack" aria-hidden="true"></i>
                                                </span>
                                            {{/iscenterfixed}}
                                        </span>
                                    </div>
                                {{/thumbnails}}
                                {{#hasmorethumbnails}}
                                    <div class="local-course-banner-builder-thumb-more">+{{morethumbnailscount}}</div>
                                {{/hasmorethumbnails}}
                            </div>
                            {{#hasbordercaption}}
                                <div class="local-course-banner-builder-thumb-caption text-muted">{{bordercaption}}</div>
                            {{/hasbordercaption}}
                            {{^hasthumbnails}}
                                <span class="text-muted{{#nothumbnailsisborderlabel}} fw-bold{{/nothumbnailsisborderlabel}}">{{nothumbnailslabel}}</span>
                            {{/hasthumbnails}}
                        </td>
                        <td class="local-course-banner-builder-source-actions-cell">
                            <div class="local-course-banner-builder-action-list">
                                <template id="local-course-banner-builder-parent-options-{{sourcekeyhash}}">
                                    {{#parentoptions}}
                                        <button type="button"
                                            class="dropdown-item local-course-banner-builder-source-option {{#selected}}active{{/selected}}"
                                            data-source-option="parent-change"
                                            data-value="{{value}}"
                                            data-label="{{label}}"
                                            data-search="{{label}}">
                                            <span class="local-course-banner-builder-source-option-label">{{label}}</span>
                                        </button>
                                    {{/parentoptions}}
                                </template>
                                <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    data-action="local-course-banner-builder-show-source-chain-preview"
                                    data-preview-url="{{previewurl}}"
                                    data-edit-url="{{editurl}}"
                                    data-edit-label="{{#str}}editsourcebutton, local_course_banner_builder{{/str}}"
                                    data-container="body"
                                    data-toggle="popover"
                                    data-placement="left"
                                    data-content="&lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;{{#str}}sourcechainpreview_help, local_course_banner_builder{{/str}}&lt;/p&gt;&lt;/div&gt;"
                                    data-html="true"
                                    data-trigger="hover">
                                    <i class="icon fa fa-eye fa-fw" aria-hidden="true"></i>
                                    <span class="local-course-banner-builder-action-label">{{#str}}preview{{/str}}</span>
                                </button>
                                <a class="btn btn-secondary btn-sm" href="{{editurl}}">
                                    <i class="icon fa fa-pen fa-fw" aria-hidden="true"></i>
                                    <span class="local-course-banner-builder-action-label">{{#str}}edit{{/str}}</span>
                                </a>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    {{#sourcekey}}<input type="hidden" name="deletesourceimages" value="{{sourcekey}}">{{/sourcekey}}
                                    {{^sourcekey}}<input type="hidden" name="deletecategoryimages" value="{{categoryid}}">{{/sourcekey}}
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                        data-modal="confirmation"
                                        data-modal-title="{{#str}}confirm{{/str}}"
                                        data-modal-content="{{#str}}deletecategoryimagesconfirm, local_course_banner_builder{{/str}}"
                                        data-modal-yes-button="{{#str}}delete{{/str}}">
                                        <i class="icon fa fa-layer-group fa-fw" aria-hidden="true"></i>
                                        <span class="local-course-banner-builder-action-label">{{#str}}deletecategoryimages, local_course_banner_builder{{/str}}</span>
                                    </button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    {{#sourcekey}}<input type="hidden" name="deletesourcecontent" value="{{sourcekey}}">{{/sourcekey}}
                                    {{^sourcekey}}<input type="hidden" name="deletecategorycontent" value="{{categoryid}}">{{/sourcekey}}
                                    <button type="submit" class="btn btn-danger btn-sm"
                                        data-modal="confirmation"
                                        data-modal-title="{{#str}}confirm{{/str}}"
                                        data-modal-content="{{#str}}deletecategorycontentconfirm, local_course_banner_builder{{/str}}"
                                        data-modal-yes-button="{{#str}}delete{{/str}}">
                                        <i class="icon fa fa-trash-can fa-fw" aria-hidden="true"></i>
                                        <span class="local-course-banner-builder-action-label">{{#str}}deletecategorycontent, local_course_banner_builder{{/str}}</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {{/items}}
            </tbody>
        </table>
    </div>
{{/hasitems}}
{{^hasitems}}
    <p class="local-course-banner-builder-empty-source-list">
        {{#str}}noconfiguredcategories, local_course_banner_builder{{/str}}
    </p>
{{/hasitems}}
</div>

<div class="modal fade" id="local-course-banner-builder-change-source-parent-modal" tabindex="-1" role="dialog"
    aria-labelledby="local-course-banner-builder-change-source-parent-title" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form method="post" class="modal-content" data-parent-source-change-form="1">
            <div class="modal-header">
                <h2 class="modal-title" id="local-course-banner-builder-change-source-parent-title">{{#str}}changesourceparent, local_course_banner_builder{{/str}}</h2>
                <button type="button" class="close" data-action="local-course-banner-builder-cancel-source-parent-change" aria-label="{{#str}}closebuttontitle{{/str}}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>{{#str}}changesourceparenthelp, local_course_banner_builder{{/str}} <strong data-parent-source-change-description="1"></strong></p>
                <p class="alert alert-danger" data-parent-source-change-error="1" hidden></p>
                <input type="hidden" name="sesskey" data-parent-source-change-sesskey="1">
                <input type="hidden" name="updatesourceparentfield" value="1">
                <input type="hidden" name="sourcekey" data-parent-source-change-key="1">
                <label for="local-course-banner-builder-change-source-parent-value">{{#str}}sourceparentkey, local_course_banner_builder{{/str}}</label>
                <input type="hidden" id="local-course-banner-builder-change-source-parent-value" name="fieldvalue" data-parent-source-change-value="1">
                <div class="dropdown local-course-banner-builder-source-dropdown local-course-banner-builder-summary-source-dropdown"
                    data-source-dropdown="parent-change"
                    data-input="#local-course-banner-builder-change-source-parent-value">
                    <button type="button" class="btn btn-outline-primary dropdown-toggle local-course-banner-builder-source-dropdown-toggle"
                        data-toggle="dropdown" data-bs-toggle="dropdown" data-display="static" data-bs-display="static"
                        aria-haspopup="true" aria-expanded="false"
                        data-source-dropdown-label="1"></button>
                    <div class="dropdown-menu local-course-banner-builder-source-dropdown-menu">
                        <div class="local-course-banner-builder-source-dropdown-search">
                            <input type="search" class="form-control form-control-sm"
                                placeholder="{{#str}}searchsourcesplaceholder, local_course_banner_builder{{/str}}"
                                data-action="local-course-banner-builder-filter-sources"
                                data-target="#local-course-banner-builder-change-source-parent-options">
                        </div>
                        <div class="local-course-banner-builder-source-dropdown-options" id="local-course-banner-builder-change-source-parent-options"
                            data-parent-source-change-options="1"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-action="local-course-banner-builder-cancel-source-parent-change">{{#str}}cancel{{/str}}</button>
                <button type="submit" class="btn btn-primary local-course-banner-builder-parent-source-save"
                    data-parent-source-change-submit="1"><i class="fa fa-save me-2" aria-hidden="true"></i>{{#str}}savechanges{{/str}}</button>
            </div>
        </form>
    </div>
</div>
