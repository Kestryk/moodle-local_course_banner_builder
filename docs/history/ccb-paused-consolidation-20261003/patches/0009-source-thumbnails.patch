+    /**
+     * Get the effective thumbnail layer specifications for a course.
+     *
+     * This contract is intentionally separate from the existing public-banner
+     * resolution. A later rendering batch will consume it after its native
+     * card and coursebox surfaces have been allocated. Until then, the current
+     * generated-thumbnail behaviour remains unchanged.
+     *
+     * @param \stdClass $course
+     * @return array
+     */
+    public static function get_thumbnail_layer_specs_for_course(\stdClass $course): array {
+        $layerspecs = self::get_enabled_category_elements_for_course($course);
+        return array_values(array_filter($layerspecs, static function (array $layerspec): bool {
+            $source = $layerspec['source'] ?? null;
+            return $source instanceof \stdClass && self::source_thumbnail_enabled($source);
+        }));
+    }
+
+    /**
+     * Whether a source contributes to derived native course thumbnails.
+     *
+     * Missing storage is treated as enabled so older databases and all existing
+     * configured sources preserve their historical output through the upgrade.
+     *
+     * @param \stdClass $source
+     * @return bool
+     */
+    public static function source_thumbnail_enabled(\stdClass $source): bool {
+        if (!self::table_field_exists('local_course_banner_builder_order', 'thumbnailenabled')) {
+            return true;
+        }
+
+        return !empty(self::get_source_settings($source)->thumbnailenabled);
+    }
+
     /**
      * Get the first matching custom-field-value source with active image layers.
      *
